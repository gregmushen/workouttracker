#!/usr/bin/env bash
# Import free-exercise-db exercises into the production database.
#
# Usage:
#   bin/import-exercises <path-to-exercises.json-on-host>
#
# Download from: https://github.com/yuhonas/free-exercise-db (dist/exercises.json)

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: bin/import-exercises <path-to-exercises-json-on-host>" >&2
  exit 1
fi

HOST_FILE="$1"
HOST="${DEPLOY_HOST:?Set DEPLOY_HOST to the Docker host}"
USER="${DEPLOY_USER:-deploy}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/deploy_key}"
SERVICE="${KAMAL_SERVICE:-workouttracker}"
DATA_VOLUME="${WORKOUTTRACKER_DATA_VOLUME:-workouttracker_data}"
DB_PATH="${WT_DB_PATH:-/data/workout.db}"
SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no $USER@$HOST"

IMAGE=$($SSH "docker inspect \$(docker ps --filter name=${SERVICE}-web --format '{{.Names}}' | head -1) --format '{{.Config.Image}}'")

echo "Using image: $IMAGE"
echo "Importing: $HOST_FILE"

$SSH "docker run --rm \
  -v \$(dirname '$HOST_FILE'):/exercise-data \
  -v $DATA_VOLUME:/data \
  --entrypoint python \
  '$IMAGE' \
  -m scripts.import_exercises \
  /exercise-data/\$(basename '$HOST_FILE') \
  '$DB_PATH'"
